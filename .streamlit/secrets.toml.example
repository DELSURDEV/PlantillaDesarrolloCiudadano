# Configuración local de la aplicación. La copia como .streamlit/secrets.toml el script de preparación.
# No contiene contraseñas ni secretos. La dirección de WAPI_ACCESS y el código de la aplicación
# son fijos de la plantilla: no se configuran aquí.

[seguridad]
# desarrollo | produccion
ambiente = "desarrollo"
sesion_max_horas = 8
inactividad_min = 30
# Intentos fallidos antes de bloquear temporalmente al usuario, y minutos de bloqueo.
intentos_maximos = 5
bloqueo_min = 15

[wapi]
# Segundos máximos de espera de la respuesta de WAPI_ACCESS.
tiempo_espera_s = 10
# Solo en producción y con aprobación de IT, mientras WAPI_ACCESS no tenga HTTPS:
# permitir_http = true
# referencia_excepcion_http = "TICKET-0000"
