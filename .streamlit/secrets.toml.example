# Copia este archivo como .streamlit/secrets.toml (lo hace herramientas/nuevo_proyecto.ps1).
# secrets.toml NUNCA se sube a Git ni se pega en el chat.

[auth]
# Debe coincidir EXACTAMENTE con la URI registrada en Entra ID (plataforma Web).
redirect_uri = "http://localhost:8501/oauth2callback"
# Lo genera el script de creación. Mínimo 32 caracteres aleatorios.
cookie_secret = "<GENERAR>"
# Datos entregados por IT. El client_id no es secreto; client_secret sí.
client_id = "<CLIENT_ID>"
client_secret = "<CLIENT_SECRET>"
server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"

[seguridad]
# desarrollo | produccion
ambiente = "desarrollo"
sesion_max_horas = 8
inactividad_min = 30
